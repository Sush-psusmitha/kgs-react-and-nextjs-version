        "nxtPcategory": "nxtPcategory",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/case\\-studies/(?<nxtPcategory>[^/]+?)/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
