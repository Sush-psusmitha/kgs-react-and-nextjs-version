15:[["$","$L1f",null,{"tag":"Data Management","title":"A Global Bank Standardised 150+ Risk & Compliance Controls","categoryName":"Data Management","categorySlug":"data-management","heroImage":{"src":"/_next/static/media/finance-blog-title-05.7a87319d.webp","height":360,"width":615,"blurDataURL":"data:image/webp;base64,UklGRkIAAABXRUJQVlA4IDYAAACwAQCdASoIAAUAAkA4JYwCdADze7UQAP6l8OfAJ3n3vRmpmL0vKRpEA26F8d+sxemJa34AAAA=","blurWidth":8,"blurHeight":5},"heroImageAlt":"Banking governance, risk and compliance"}],["$","section",null,{"className":"py-8 md:py-12","aria-label":"About the client and requirements","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":["$","div",null,{"className":"border-l-[3px] border-kgs-primary pl-6","children":[["$","h2",null,{"className":"mb-3 font-heading text-lg font-bold text-neutral-900 md:text-xl","children":"About The Client"}],["$","p",null,{"className":"font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":"The client is a large banking and financial services institution operating across multiple business units, products, and markets. Its risk and compliance teams managed regulatory requirements, internal controls, risk assessments, compliance reviews, documentation, and remediation activities across a complex operating environment. As regulatory obligations and transaction volumes increased, fragmented processes made it harder to maintain consistent oversight across functions. The institution needed a structured risk and compliance model to centralise control monitoring, improve risk visibility, strengthen documentation, and support ongoing regulatory readiness."}]]}]}]}],["$","section",null,{"className":"pb-14 md:pb-16","aria-label":"Key statistics","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-6 border-t border-neutral-200/80 pt-10 md:pt-12","children":[["$","$1","0",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"150"}],["$","span",null,{"className":"text-kgs-primary","children":"+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Risk & Compliance Controls Managed"}]]}],["$","div",null,{"className":"hidden h-12 w-px bg-neutral-200/80 md:block","aria-hidden":"true"}]]}],["$","$1","1",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"50"}],["$","span",null,{"className":"text-kgs-primary","children":"+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Business Processes Assessed"}]]}],["$","div",null,{"className":"hidden h-12 w-px bg-neutral-200/80 md:block","aria-hidden":"true"}]]}],["$","$1","2",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"2,500"}],["$","span",null,{"className":"text-kgs-primary","children":"+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Compliance Records Reviewed"}]]}],["$","div",null,{"className":"hidden h-12 w-px bg-neutral-200/80 md:block","aria-hidden":"true"}]]}],["$","$1","3",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":["$L20","$L21"]}],false]}]]}]}