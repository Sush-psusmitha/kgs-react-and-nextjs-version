20:["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"100"}],["$","span",null,{"className":"text-kgs-primary","children":"%"}]]}]
21:["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Priority Findings Mapped for Remediation"}]
22:["$","section",null,{"className":"pb-16 md:pb-20","aria-label":"Case study narrative and results","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":[["$","div",null,{"className":"grid grid-cols-1 items-start gap-12 lg:grid-cols-10 lg:gap-16","children":[["$","div",null,{"className":"flex flex-col gap-10 lg:col-span-7","children":[["$","div",null,{"children":[["$","h2",null,{"className":"mb-4 font-heading text-2xl font-bold text-neutral-900 md:text-3xl","children":"The Challenge"}],["$","div",null,{"className":"space-y-4 font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":[["$","p","0",{"children":"Risk and compliance information was maintained in separate spreadsheets, departmental tools, and legacy systems across retail, commercial, and wealth management units."}],["$","p","1",{"children":"Control testing and evidence collection were largely manual, creating heavy administrative burdens during internal and external regulatory audits."}],["$","p","2",{"children":"Risk definitions and severity ratings varied across entities, making it difficult for executive leadership to obtain an enterprise-wide risk posture."}],["$","p","3",{"children":"Tracking remediation actions for audit findings was fragmented, with deadlines and ownership frequently lacking centralized oversight."}],["$","p","4",{"children":"Regulatory reporting required substantial manual data aggregation and reconciliation from multiple transaction and compliance systems."}],["$","p","5",{"children":"The bank needed a consolidated data governance and compliance management framework to standardise controls, automate evidence tracking, and enhance risk transparency."}]]}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"mb-4 font-heading text-2xl font-bold text-neutral-900 md:text-3xl","children":"What Did KGS Do"}],["$","div",null,{"className":"space-y-4 font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":[["$","p","0",{"children":"KGS conducted an end-to-end evaluation of the bank's regulatory obligations, risk taxonomies, control frameworks, and compliance reporting requirements."}],["$","p","1",{"children":"More than 150 critical risk and compliance controls across 50+ core business processes were harmonized and brought into a unified data governance model."}],["$","p","2",{"children":"Structured evidence-gathering workflows and validation checkpoints were instituted, reviewing over 2,500 compliance records to ensure data integrity and completeness."}],["$","p","3",{"children":"KGS implemented standardized risk rating matrices and remediation tracking dashboards, ensuring that 100% of priority audit findings were assigned clear ownership and milestone schedules."}],["$","p","4",{"children":"Automated compliance reporting pipelines were established to pull validated data directly from source systems, significantly reducing manual compilation efforts for regulatory filings."}]]}]]}]]}],["$","div",null,{"className":"flex flex-col gap-6 lg:col-span-3 lg:sticky lg:top-24","children":[["$","div",null,{"className":"overflow-hidden rounded-2xl shadow-sm border border-neutral-100 bg-neutral-100","children":["$","img",null,{"src":"/_next/static/media/case-studies-sidebar.ee520c04.png","alt":"Banking governance, risk and compliance","className":"w-full h-auto object-cover"}]}],["$","div",null,{"className":"rounded-2xl border border-neutral-200/80 bg-neutral-50/70 p-5 shadow-xs","children":[["$","div",null,{"className":"mb-4 flex items-center gap-2 border-b border-neutral-200/80 pb-3","children":[["$","svg",null,{"stroke":"currentColor","fill":"currentColor","strokeWidth":"0","viewBox":"0 0 512 512","className":"text-kgs-primary","children":["$undefined",["$L25"]],"style":{"color":"$undefined"},"height":15,"width":15,"xmlns":"http://www.w3.org/2000/svg"}],"$L26"]}],"$L27","$L28"]}]]}]]}],"$L29"]}]}]
