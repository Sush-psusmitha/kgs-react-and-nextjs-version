15:[["$","$L1f",null,{"tag":"Business Process Automation","title":"A Multi-Entity Bank Streamlined 1M+ Monthly Transactions to Improve Processing Accuracy","categoryName":"Business Process Automation","categorySlug":"business-process-automation","heroImage":{"src":"/_next/static/media/finance-blog-title-06.e9b7f70e.webp","height":360,"width":615,"blurDataURL":"data:image/webp;base64,UklGRkoAAABXRUJQVlA4ID4AAACwAQCdASoIAAUAAkA4JQBOgB6RnkeAAPl/45ErZz4LV7kof2399JlMLcgQ8WqaMF/CQuTiVgBrkBg5/AAAAA==","blurWidth":8,"blurHeight":5},"heroImageAlt":"Banking operations and transactions management"}],["$","section",null,{"className":"py-8 md:py-12","aria-label":"About the client and requirements","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":["$","div",null,{"className":"border-l-[3px] border-kgs-primary pl-6","children":[["$","h2",null,{"className":"mb-3 font-heading text-lg font-bold text-neutral-900 md:text-xl","children":"About The Client"}],["$","p",null,{"className":"font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":"The client is a large banking and financial services institution serving retail, commercial, and corporate customers across multiple business units. Its operations teams managed high volumes of transactions, account servicing requests, payments, reconciliations, documentation, and operational exceptions across a complex banking environment. As transaction volumes grew, repetitive manual activities and fragmented workflows increased processing effort and made it harder to maintain consistent turnaround times. The organisation needed a scalable banking operations model that could standardise recurring activities, strengthen controls, improve exception management, and support efficient processing across its financial operations."}]]}]}]}],["$","section",null,{"className":"pb-14 md:pb-16","aria-label":"Key statistics","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-6 border-t border-neutral-200/80 pt-10 md:pt-12","children":[["$","$1","0",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"1"}],["$","span",null,{"className":"text-kgs-primary","children":"M+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Transactions Supported Monthly"}]]}],["$","div",null,{"className":"hidden h-12 w-px bg-neutral-200/80 md:block","aria-hidden":"true"}]]}],["$","$1","1",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"99"}],["$","span",null,{"className":"text-kgs-primary","children":"%+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Processing Accuracy"}]]}],["$","div",null,{"className":"hidden h-12 w-px bg-neutral-200/80 md:block","aria-hidden":"true"}]]}],["$","$1","2",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"50"}],["$","span",null,{"className":"text-kgs-primary","children":"+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Banking Workflows Managed"}]]}],"$L20"]}],"$L21"]}]}]}],"$L22","$L23","$L24"]
