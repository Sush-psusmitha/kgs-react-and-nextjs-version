22:["$","section",null,{"className":"pb-16 md:pb-20","aria-label":"Case study narrative and results","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":[["$","div",null,{"className":"grid grid-cols-1 items-start gap-12 lg:grid-cols-10 lg:gap-16","children":[["$","div",null,{"className":"flex flex-col gap-10 lg:col-span-7","children":[["$","div",null,{"children":[["$","h2",null,{"className":"mb-4 font-heading text-2xl font-bold text-neutral-900 md:text-3xl","children":"The Challenge"}],["$","div",null,{"className":"space-y-4 font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":[["$","p","0",{"children":"Banking operations teams managed extensive transaction activity every day across customer accounts, commercial lending, trade services, payment execution, and treasury support."}],["$","p","1",{"children":"Information arrived in structured and unstructured formats through core banking platforms, messaging networks, customer requests, internal ticketing systems, and physical documentation."}],["$","p","2",{"children":"Manual entry, routine validations, document reconciliation, and exception research consumed significant time and increased the risk of processing delays."}],["$","p","3",{"children":"Differences in operating procedures across business entities created inconsistencies in how requests were handled, tracked, and reported."}],["$","p","4",{"children":"Operations leaders lacked consolidated visibility into processing queues, ageing requests, exception patterns, and team capacity across entities."}],["$","p","5",{"children":"The organisation required an operational framework that could standardise high-volume banking processes, strengthen controls, and improve efficiency while maintaining regulatory compliance."}]]}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"mb-4 font-heading text-2xl font-bold text-neutral-900 md:text-3xl","children":"What Did KGS Do"}],["$","div",null,{"className":"space-y-4 font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":[["$","p","0",{"children":"KGS conducted a comprehensive review of the bank's operational workflows, transaction types, source systems, exception rules, documentation requirements, and service-level commitments across business entities."}],["$","p","1",{"children":"Standard operating procedures were designed and implemented to support more than 1,000,000 transactions and servicing requests each month."}],["$","p","2",{"children":"KGS established dedicated operational teams to support account servicing, transaction validation, payment execution support, reconciliation, documentation checks, and structured exception handling."}],["$","p","3",{"children":"Transaction queues were categorised by complexity, priority, and processing criteria, allowing standard requests to move rapidly through defined steps while complex exceptions were routed with supporting documentation for specialist investigation."}],["$","p","4",{"children":"Daily operational tracking, quality audits, and performance dashboards provided managers with real-time visibility into queue volumes, turnaround times, exception trends, and error rates across all entities."}]]}]]}]]}],["$","div",null,{"className":"flex flex-col gap-6 lg:col-span-3 lg:sticky lg:top-24","children":[["$","div",null,{"className":"overflow-hidden rounded-2xl shadow-sm border border-neutral-100 bg-neutral-100","children":["$","img",null,{"src":"/_next/static/media/case-studies-sidebar.ee520c04.png","alt":"Banking operations and transactions management","className":"w-full h-auto object-cover"}]}],"$L25"]}]]}],"$L26"]}]}]
