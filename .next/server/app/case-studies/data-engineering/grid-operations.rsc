22:["$","$1","3",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"35"}],["$","span",null,{"className":"text-kgs-primary","children":"%"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Reduction in Manual Operational Effort"}]]}],false]}]
23:["$","section",null,{"className":"pb-16 md:pb-20","aria-label":"Case study narrative and results","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":[["$","div",null,{"className":"grid grid-cols-1 items-start gap-12 lg:grid-cols-10 lg:gap-16","children":[["$","div",null,{"className":"flex flex-col gap-10 lg:col-span-7","children":[["$","div",null,{"children":[["$","h2",null,{"className":"mb-4 font-heading text-2xl font-bold text-neutral-900 md:text-3xl","children":"The Challenge"}],["$","div",null,{"className":"space-y-4 font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":[["$","p","0",{"children":"Grid telemetry, sensor data, field reports, weather feeds, and asset histories were distributed across separate operational technology (OT) and information technology (IT) systems."}],["$","p","1",{"children":"Control room operators spent considerable time switching between disparate applications to piece together situational awareness during outages and network stress events."}],["$","p","2",{"children":"Sensor data streams generated high volumes of time-series records that legacy systems could not process or visualize in near real-time."}],["$","p","3",{"children":"Field crews often lacked timely, enriched operational data when dispatched, leading to longer restoration times."}],["$","p","4",{"children":"Asset maintenance teams struggled to correlate operational telemetry with historical asset degradation to prioritize preventive maintenance."}],["$","p","5",{"children":"The utility required a unified data engineering solution capable of ingesting high-frequency grid data, standardising asset records, and delivering real-time operational insights."}]]}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"mb-4 font-heading text-2xl font-bold text-neutral-900 md:text-3xl","children":"What Did KGS Do"}],["$","div",null,{"className":"space-y-4 font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":[["$","p","0",{"children":"KGS analyzed the utility's SCADA networks, smart meter infrastructure, GIS systems, outage management systems (OMS), and asset management databases."}],["$","p","1",{"children":"A scalable real-time and batch data pipeline architecture was established to ingest, parse, and harmonize telemetry from 100,000+ grid assets and smart devices."}],["$","p","2",{"children":"Time-series data pipelines were implemented to process sensor readings, voltage fluctuations, load profiles, and fault logs with sub-second latency."}],["$","p","3",{"children":"Asset identifiers and spatial coordinates were reconciled across GIS and operational databases to create a unified topological view of the distribution grid."}],["$","p","4",{"children":"Operational dashboards and alert feeds were deployed for control room teams and field supervisors, enabling faster incident triage and proactive dispatching."}]]}]]}]]}],["$","div",null,{"className":"flex flex-col gap-6 lg:col-span-3 lg:sticky lg:top-24","children":[["$","div",null,{"className":"overflow-hidden rounded-2xl shadow-sm border border-neutral-100 bg-neutral-100","children":["$","img",null,{"src":"/_next/static/media/case-studies-sidebar.ee520c04.png","alt":"Utility grid operations infrastructure","className":"w-full h-auto object-cover"}]}],["$","div",null,{"className":"rounded-2xl border border-neutral-200/80 bg-neutral-50/70 p-5 shadow-xs","children":[["$","div",null,{"className":"mb-4 flex items-center gap-2 border-b border-neutral-200/80 pb-3","children":[["$","svg",null,{"stroke":"currentColor","fill":"currentColor","strokeWidth":"0","viewBox":"0 0 512 512","className":"text-kgs-primary","children":["$undefined",["$L26"]],"style":{"color":"$undefined"},"height":15,"width":15,"xmlns":"http://www.w3.org/2000/svg"}],"$L27"]}],"$L28","$L29"]}]]}]]}],"$L2a"]}]}]
