16:[["$","$L20",null,{"tag":"Data Engineering","title":"A Multi-Region Utility Provider Improved Visibility Across 100,000+ Grid Assets","categoryName":"Data Engineering","categorySlug":"data-engineering","heroImage":{"src":"/_next/static/media/energy-utilities.ce1461b1.webp","height":850,"width":1920,"blurDataURL":"data:image/webp;base64,UklGRlAAAABXRUJQVlA4IEQAAADQAQCdASoIAAQAAkA4JbACdAD0gbffAAD+/SVZgM/Pvi1UeLvaWMMfJu54Gl64DhZDAVn1jRZW/Bzh4Cu+S3o6LAAAAA==","blurWidth":8,"blurHeight":4},"heroImageAlt":"Utility grid operations infrastructure"}],["$","section",null,{"className":"py-8 md:py-12","aria-label":"About the client and requirements","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":["$","div",null,{"className":"border-l-[3px] border-kgs-primary pl-6","children":[["$","h2",null,{"className":"mb-3 font-heading text-lg font-bold text-neutral-900 md:text-xl","children":"About The Client"}],["$","p",null,{"className":"font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":"The client is a large energy and utility provider managing electricity distribution infrastructure across multiple service regions. Its grid operations teams were responsible for monitoring substations, transformers, feeders, distribution equipment, and other critical network assets. Operational information came from grid management platforms, asset systems, field applications, GIS environments, and monitoring systems. As the network expanded, fragmented information and manual coordination made it harder to maintain a consistent view of grid conditions, incidents, and field activities. The organisation needed a scalable grid operations model to improve operational visibility, strengthen data management, coordinate field response, and support more efficient management of its distribution network."}]]}]}]}],["$","section",null,{"className":"pb-14 md:pb-16","aria-label":"Key statistics","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-6 border-t border-neutral-200/80 pt-10 md:pt-12","children":[["$","$1","0",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"100,000"}],["$","span",null,{"className":"text-kgs-primary","children":"+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Grid Assets Monitored"}]]}],["$","div",null,{"className":"hidden h-12 w-px bg-neutral-200/80 md:block","aria-hidden":"true"}]]}],["$","$1","1",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"25"}],["$","span",null,{"className":"text-kgs-primary","children":"+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Operational Data Sources Integrated"}]]}],["$","div",null,{"className":"hidden h-12 w-px bg-neutral-200/80 md:block","aria-hidden":"true"}]]}],["$","$1","2",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"30"}],["$","span",null,{"className":"text-kgs-primary","children":"%"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Faster Incident Response"}]]}],"$L21"]}],"$L22"]}]}]}],"$L23","$L24","$L25"]
