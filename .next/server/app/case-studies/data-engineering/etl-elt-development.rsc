16:[["$","$L20",null,{"tag":"Data Engineering","title":"A Global Enterprise Built 60+ ETL and ELT Workflows to Process 25M+ Records Daily Across Its Modern Data Environment","categoryName":"Data Engineering","categorySlug":"data-engineering","heroImage":{"src":"/_next/static/media/logistics-blog-title-08.8b441753.webp","height":360,"width":615,"blurDataURL":"data:image/webp;base64,UklGRkoAAABXRUJQVlA4ID4AAACwAQCdASoIAAUAAkA4JQBOgCHXYJAAAP68mrR50E5RUpCy0ChRMXtuxFAvmNDGjmZku6DARjsibgstJnoAAA==","blurWidth":8,"blurHeight":5},"heroImageAlt":"Freight and logistics operations data pipelines"}],["$","section",null,{"className":"py-8 md:py-12","aria-label":"About the client and requirements","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":["$","div",null,{"className":"border-l-[3px] border-kgs-primary pl-6","children":[["$","h2",null,{"className":"mb-3 font-heading text-lg font-bold text-neutral-900 md:text-xl","children":"About The Client"}],["$","p",null,{"className":"font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":"The client is a global enterprise managing large volumes of customer, financial, operational, and transactional data across multiple business functions. Information originated from ERP and CRM platforms, databases, cloud applications, APIs, and legacy systems, with different teams relying on this data for reporting and analytics. Existing data transformation processes had developed independently and required significant maintenance as sources and volumes increased. The organisation needed scalable ETL and ELT development to automate data extraction, loading, and transformation while improving data quality, processing reliability, and availability for downstream analytics."}]]}]}]}],["$","section",null,{"className":"pb-14 md:pb-16","aria-label":"Key statistics","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-6 border-t border-neutral-200/80 pt-10 md:pt-12","children":[["$","$1","0",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"60"}],["$","span",null,{"className":"text-kgs-primary","children":"+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"ETL & ELT Workflows Developed"}]]}],["$","div",null,{"className":"hidden h-12 w-px bg-neutral-200/80 md:block","aria-hidden":"true"}]]}],["$","$1","1",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"25"}],["$","span",null,{"className":"text-kgs-primary","children":"M+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Records Processed Daily"}]]}],["$","div",null,{"className":"hidden h-12 w-px bg-neutral-200/80 md:block","aria-hidden":"true"}]]}],["$","$1","2",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"30"}],["$","span",null,{"className":"text-kgs-primary","children":"+"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Data Sources Integrated"}]]}],["$","div",null,{"className":"hidden h-12 w-px bg-neutral-200/80 md:block","aria-hidden":"true"}]]}],"$L21"]}]}]}],"$L22","$L23","$L24"]
21:["$","$1","3",{"children":[["$","div",null,{"className":"flex-1 min-w-[140px] text-center","children":[["$","p",null,{"className":"mb-2 font-heading text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl lg:text-5xl","children":[["$","span",null,{"children":"99.9"}],["$","span",null,{"className":"text-kgs-primary","children":"%"}]]}],["$","p",null,{"className":"font-body text-xs font-semibold uppercase tracking-wider text-neutral-600 sm:text-[13px]","children":"Pipeline Availability Target"}]]}],false]}]
22:["$","section",null,{"className":"pb-16 md:pb-20","aria-label":"Case study narrative and results","children":["$","div",null,{"className":"mx-auto w-[92%] max-w-[1920px]","children":[["$","div",null,{"className":"grid grid-cols-1 items-start gap-12 lg:grid-cols-10 lg:gap-16","children":[["$","div",null,{"className":"flex flex-col gap-10 lg:col-span-7","children":[["$","div",null,{"children":[["$","h2",null,{"className":"mb-4 font-heading text-2xl font-bold text-neutral-900 md:text-3xl","children":"The Challenge"}],["$","div",null,{"className":"space-y-4 font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":[["$","p","0",{"children":"Data existed in diverse formats across cloud applications, on-premises databases, ERP systems, third-party platforms, and flat files with varying update frequencies."}],["$","p","1",{"children":"Different business units had built their own transformation scripts and scheduled jobs, creating inconsistent data definitions and frequent maintenance issues."}],["$","p","2",{"children":"Pipeline failures often went undetected until business teams noticed missing or incorrect numbers in analytics dashboards."}],["$","p","3",{"children":"Batch pipelines struggled to keep pace as daily data volumes grew, causing processing delays that affected morning operational reports."}],["$","p","4",{"children":"Transformations were tightly coupled to source-system schemas, meaning minor upstream schema changes frequently broke downstream reports."}],["$","p","5",{"children":"The client needed a modern, resilient data integration framework that applied ETL and ELT appropriately based on workload requirements."}]]}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"mb-4 font-heading text-2xl font-bold text-neutral-900 md:text-3xl","children":"What Did KGS Do"}],["$","div",null,{"className":"space-y-4 font-body text-base font-medium leading-[1.78] text-neutral-700 md:text-md","children":[["$","p","0",{"children":"KGS evaluated the client's source systems, data volumes, ingestion frequencies, downstream analytics requirements, and existing pipeline architectures."}],["$","p","1",{"children":"A hybrid ETL/ELT architecture was designed, using ELT for cloud data warehouse workloads requiring high transformation flexibility and ETL for workloads requiring upfront cleansing, masking, or compliance filtering."}],["$","p","2",{"children":"More than 60 modular, reusable data pipelines were built using modern orchestration and transformation frameworks, integrating data from 30+ enterprise sources."}],["$","p","3",{"children":"Automated data validation checks were embedded at ingestion and transformation stages to detect anomalies, schema changes, and missing data before records reached analytics layers."}],["$","p","4",{"children":"Comprehensive monitoring and alerting were established to track pipeline performance, data freshness, row counts, and error states in real time."}]]}]]}]]}],["$","div",null,{"className":"flex flex-col gap-6 lg:col-span-3 lg:sticky lg:top-24","children":[["$","div",null,{"className":"overflow-hidden rounded-2xl shadow-sm border border-neutral-100 bg-neutral-100","children":["$","img",null,{"src":"/_next/static/media/case-studies-sidebar.ee520c04.png","alt":"Freight and logistics operations data pipelines","className":"w-full h-auto object-cover"}]}],["$","div",null,{"className":"rounded-2xl border border-neutral-200/80 bg-neutral-50/70 p-5 shadow-xs","children":[["$","div",null,{"className":"mb-4 flex items-center gap-2 border-b border-neutral-200/80 pb-3","children":[["$","svg",null,{"stroke":"currentColor","fill":"currentColor","strokeWidth":"0","viewBox":"0 0 512 512","className":"text-kgs-primary","children":["$undefined",["$L25"]],"style":{"color":"$undefined"},"height":15,"width":15,"xmlns":"http://www.w3.org/2000/svg"}],"$L26"]}],"$L27","$L28"]}]]}]]}],"$L29"]}]}]
