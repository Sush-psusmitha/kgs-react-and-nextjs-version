25:["$","$L32",null,{"cards":[{"icon":{"src":"/_next/static/media/more-time-for-high-value-work.91a00503.svg","height":30,"width":30,"blurWidth":0,"blurHeight":0},"title":"More Time for High-Value Work","desc":"Automation eliminates repetitive tasks, allowing your skilled teams to focus on strategic work that drives greater business impact."},{"icon":{"src":"/_next/static/media/reliable-process-accuracy.4295f40e.svg","height":30,"width":30,"blurWidth":0,"blurHeight":0},"title":"Reliable Process Accuracy","desc":"Robotic automation execute your routine tasks consistently, reducing manual errors and improving operational reliability."},{"icon":{"src":"/_next/static/media/intelligent-exception-handling.630e2cdb.svg","height":30,"width":30,"blurWidth":0,"blurHeight":0},"title":"Intelligent Exception Handling","desc":"Our intelligent automation solutions recognize process exceptions and route them through the right workflows without disrupting business continuity."},{"icon":{"src":"/_next/static/media/returns-you-can-measure.94d65506.svg","height":30,"width":30,"blurWidth":0,"blurHeight":0},"title":"Returns You Can Measure","desc":"Track productivity gains, reduced processing time, and operational improvements with KGS's automation solutions designed around measurable business outcomes."},{"icon":{"src":"/_next/static/media/capacity-that-grows-with-demand.37a44ed7.svg","height":30,"width":30,"blurWidth":0,"blurHeight":0},"title":"Capacity That Grows with Demand","desc":"Expand operations through automation that support increasing workloads without proportional increases in manual effort."},{"icon":{"src":"/_next/static/media/faster-path-to-production.98669560.svg","height":30,"width":30,"blurWidth":0,"blurHeight":0},"title":"Faster Path to Production","desc":"Our proven pilot approach validates business outcomes within weeks, providing the confidence to scale automation across the enterprise."},{"icon":{"src":"/_next/static/media/teams-focused-on-what-matters.7fad91e9.sv