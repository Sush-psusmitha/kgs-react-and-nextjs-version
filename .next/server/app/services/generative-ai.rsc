25:["$","section",null,{"className":"bg-white py-16 text-center nav:py-24","children":[["$","div",null,{"className":"mx-auto w-3/4 max-w-3xl","children":[["$","h2",null,{"className":"mb-4 font-heading text-2xl font-bold text-neutral-900 nav:text-3xl","children":"Your Business. Our AI Expertise. Proven Results."}],["$","p",null,{"className":"mb-12 font-body leading-relaxed text-neutral-700","children":"We combine deep technical expertise with a robust ecosystem of AI models, cloud platforms, and enterprise technologies to deliver secure, scalable, and production-ready solutions. Every engagement is aligned with client requirements for performance, compliance, privacy, and long-term business value."}]]}],["$","div",null,{"className":"flex flex-col items-center gap-8","children":[["$","div",null,{"className":"flex flex-wrap items-center justify-center gap-x-14 gap-y-6","children":[["$","img","AWS",{"src":"/_next/static/media/aws.6355340c.png","alt":"AWS","loading":"lazy","className":"h-8 w-auto max-w-[140px] object-contain nav:h-[55px]"}],["$","img","Microsoft",{"src":"/_next/static/media/microsoft.ed23fe34.png","alt":"Microsoft","loading":"lazy","className":"h-8 w-auto max-w-[140px] object-contain nav:h-[55px]"}],["$","img","Oracle Cloud Platform",{"src":"/_next/static/media/oracle-scm-cloud.50faede9.png","alt":"Oracle Cloud Platform","loading":"lazy","className":"h-8 w-auto max-w-[140px] object-contain nav:h-[55px]"}],["$","img","ServiceNow",{"src":"/_next/static/media/servicenow-logo 1.7968d694.png","alt":"ServiceNow","loading":"lazy","className":"h-8 w-auto max-w-[140px] object-contain nav:h-[55px]"}]]}],["$","div",null,{"className":"flex flex-wrap items-center justify-center gap-x-14 gap-y-6","children":[["$","img","SAP",{"src":"/_next/static/media/sap.2a3c1aa3.png","alt":"SAP","loading":"lazy","className":"h-8 w-auto max-w-[140px] object-contain nav:h-[55px]"}],["$","img","Power BI",{"src":"/_next/static/media/power-bi.ffdb54c2.png","alt":"Power BI","loading":"la